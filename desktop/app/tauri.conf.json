{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAF Kanban",
  "identifier": "io.github.whlshy.saf-kanban",
  "build": {
    "frontendDist": "../../dist-local"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "SAF Kanban",
    "longDescription": "A kanban board that keeps its boards on this computer.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "externalBin": [
      "binaries/saf-kanban-cli"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMUI2NUM1NjMxQTYxRDAKUldUUVlScGp4V1Viak9PZEJzTjZkTTZaRE52VytaODg2YngvMHRoU1lqT0creUpQYjJvajhYd2EK",
      "endpoints": [
        "https://github.com/whlshy/SAF_Kanban/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
