{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAF Kanban",
  "identifier": "io.github.whlshy.saf-kanban",
  "build": {
    "frontendDist": "../../dist-local"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "SAF Kanban",
    "longDescription": "A kanban board that keeps its boards on this computer.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
